{
  "opencollection": "1.0.0",
  "info": {
    "name": "DMI Backend actions api-keys API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "api-keys",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Api Keys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/api-keys/"
          },
          "docs": "List the caller's API keys — summaries only."
        },
        {
          "info": {
            "name": "Create Api Key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/api-keys/",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Mint a new API key. The plaintext secret is returned ONCE."
        },
        {
          "info": {
            "name": "Revoke Api Key",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/api-keys/:key_id",
            "params": [
              {
                "name": "key_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Soft-revoke an API key (is_active → False)."
        }
      ]
    }
  ],
  "bundled": true
}