          "name": "List User Permissions",
          "request": {
            "name": "List User Permissions",
            "description": {
              "content": "List all permissions for a user with resource names. Requires owner.\n\nIncludes both direct user grants and grants via the user's effective\ngroups. Role check lives inside\n:class:`ListUserPermissions.execute_with_names` — raises\n:class:`PermissionDenied` (→ HTTP 403) when the caller isn't an owner.",
              "type": "text/plain"
            },
            "url": {
