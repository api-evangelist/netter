                "name": "project_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "parent_slug",
                "value": "",
                "type": "query"
              },
              {
                "name": "child_slug",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Remove a parent → child edge. Takes `parent_slug` + `child_slug` as query params."
