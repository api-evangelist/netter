      "items": [
        {
          "info": {
            "name": "Get Or Create Chat",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/lego-architect/projects/:project_id/chat",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get or create the lego-architect chat for this project."
        },
        {
          "info": {
            "name": "Send Message",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/lego-architect/:chat_id/message",
            "params": [
              {
                "name": "chat_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Dispatch a new lego-architect turn for this chat."
        },
        {
          "info": {
            "name": "Add Step",
            "type": "http"
