          "name": "Run App Query Batch",
          "request": {
            "name": "Run App Query Batch",
            "description": {
              "content": "Run several guarded SELECTs against the app's bound entities in one\nrequest, sharing a single DuckDB connection + one materialized merge.\n\nApp-level failures (missing / not ready) return 404 / 409. Per-query\nfailures (bad SQL, DuckDB errors) are isolated into each result's\n``error`` field with HTTP 200 — one broken widget never blanks the page.",
              "type": "text/plain"
            },
