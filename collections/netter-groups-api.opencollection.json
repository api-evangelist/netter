          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/groups"
          },
          "docs": "List all groups for the company. Available to any company member."
        },
        {
          "info": {
            "name": "Create Group",
            "type": "http"
          },
          "http": {
            "method": "POST",
