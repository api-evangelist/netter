          "docs": "Get manual and effective members of a group. Requires company admin."
        },
        {
          "info": {
            "name": "Add Group Member",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/groups/:group_id/members/:user_id",
            "params": [
              {
                "name": "group_id",
                "value": "",
